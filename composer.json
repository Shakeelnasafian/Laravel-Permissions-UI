{
  "name": "shakeelnasafian/laravel-spatie-permission-manager",
  "description": "Elegant UI for managing spatie/laravel-permission roles and permissions",
  "version": "0.1.0",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^12.0",
    "spatie/laravel-permission": "^6.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Shakeelnasafian\\PermissionManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shakeelnasafian\\PermissionManager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Shakeelnasafian\\PermissionManager\\PermissionManagerServiceProvider"
      ]
    }
  }
}
